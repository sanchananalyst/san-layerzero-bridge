# Non-secret configuration only. Do not put secrets, private keys, mnemonics, or
# seed phrases in this file or in committed configuration.

# Optional read-only RPC overrides
ROBINHOOD_RPC_URL=
SOLANA_MAINNET_RPC_URL=
# LayerZero/Hardhat task aliases for the same read-only endpoints. Mainnet
# transaction paths remain structurally disabled throughout Phase 5A.
RPC_URL_ROBINHOOD=
RPC_URL_SOLANA=

# The only canonical SAN mint on Solana
SAN_SOLANA_MINT=GQz5ThKHNcuAvMKA8rCPSdoFUoApk9Fi8qB9m3Gqpump
SAN_SOLANA_TOKEN_PROGRAM=
SAN_SOLANA_DECIMALS=

# LayerZero application identities. The OFT Store and EVM OFT do not exist yet.
SAN_SOLANA_OFT_PROGRAM_ID=9myHzfqsbJfGbYxpCvVCYqLaB4Co1RCo2a8T4QSkTvcD
SAN_SOLANA_OFT_STORE=
SAN_SOLANA_ESCROW=
SAN_ROBINHOOD_OFT_ADDRESS=
SAN_ROBINHOOD_OWNER=
SAN_ROBINHOOD_DELEGATE=
SAN_SOLANA_UPGRADE_AUTHORITY=
SAN_SOLANA_STORE_ADMIN=
SAN_SOLANA_DELEGATE=
SAN_SOLANA_PAUSER=
SAN_SOLANA_UNPAUSER=
# Intentionally blank until the finality policy receives explicit approval.
SAN_ROBINHOOD_SOURCE_CONFIRMATIONS=

# Read-only production activation checker. Hashes and identities must come
# from reviewed build/governance artifacts; values are never inferred.
SAN_EXPECTED_ACTIVATION_STATE=PRE_ACTIVATION_INERT
SAN_SOLANA_PROGRAM_DATA=
SAN_SOLANA_PROGRAM_DATA_SHA256=
SAN_ROBINHOOD_RUNTIME_CODE_HASH=
SAN_EXPECTED_ROBINHOOD_SUPPLY_RAW=0
SAN_EXPECTED_SOLANA_MINT_SUPPLY_RAW=
# Use NONE only when read-only RPC confirms that authority is revoked.
SAN_EXPECTED_SOLANA_MINT_AUTHORITY=NONE
SAN_EXPECTED_SOLANA_FREEZE_AUTHORITY=NONE
# Comma-separated bootstrap/deployer public identities that must hold no role.
SAN_FORBIDDEN_SOLANA_BOOTSTRAP_AUTHORITIES=
SAN_FORBIDDEN_ROBINHOOD_BOOTSTRAP_AUTHORITIES=
SAN_APPROVED_IN_FLIGHT_INVENTORY_ID=
SAN_APPROVED_IN_FLIGHT_INVENTORY_SHA256=
SAN_APPROVED_IN_FLIGHT_SOLANA_TO_ROBINHOOD_RAW=0
SAN_APPROVED_IN_FLIGHT_ROBINHOOD_TO_SOLANA_RAW=0
SAN_OBSERVED_IN_FLIGHT_INVENTORY_PATH=

# Testnet-only public identities. The mint must be a NEW tSAN mint created on
# Solana Devnet in a later authorized phase; canonical SAN is rejected.
SOLANA_DEVNET_RPC_URL=
ROBINHOOD_TESTNET_RPC_URL=
TESTNET_SOLANA_MINT=
TESTNET_SOLANA_OFT_STORE=
TESTNET_ROBINHOOD_OFT_ADDRESS=
TESTNET_SOLANA_EID=40168
TESTNET_ROBINHOOD_EID=40451
TESTNET_ROBINHOOD_CHAIN_ID=46630
